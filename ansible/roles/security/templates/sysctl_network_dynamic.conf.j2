{# Network buffers: scale with RAM #}
{% set ram_mb = ansible_facts['memtotal_mb'] | int %}
{% set ram_gb = (ram_mb / 1024) | round(2) %}

{# rmem_max: max socket receive buffer - 4x RAM in bytes, clamped #}
{% set rmem_max = (ram_gb * 1048576 * 4) | int %}
{% set rmem_max = [rmem_max, 16777216] | max %}
{% set rmem_max = [rmem_max, 268435456] | min %}

{# wmem_max: max socket write buffer = rmem_max #}
{% set wmem_max = rmem_max %}

{# rmem_default: 1/4 of max #}
{% set rmem_default = (rmem_max // 4) | int %}
{% set rmem_default = [rmem_default, 262144] | max %}

{# wmem_default = rmem_default #}
{% set wmem_default = rmem_default %}

{# optmem_max: 1/2 of max #}
{% set optmem_max = (rmem_max // 2) | int %}
{% set optmem_max = [optmem_max, 65536] | max %}

{# udp_mem: 256 pages (1 MB) per MB of RAM, in pages (4 KB each) #}
{% set udp_pages = ram_mb * 256 %}
{% set udp_low = (udp_pages * 0.5) | int %}
{% set udp_pressure = udp_pages %}
{% set udp_high = (udp_pages * 2) | int %}

net.core.rmem_max={{ rmem_max }}
net.core.wmem_max={{ wmem_max }}
net.core.rmem_default={{ rmem_default }}
net.core.wmem_default={{ wmem_default }}
net.core.optmem_max={{ optmem_max }}
net.ipv4.udp_mem={{ udp_low }} {{ udp_pressure }} {{ udp_high }}
