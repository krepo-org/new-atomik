{# Tuned profile: scale with hardware #}
{% set ram_mb = ansible_facts['memtotal_mb'] | int %}
{% set vcpus = ansible_facts['processor_vcpus'] | int %}

{# min_perf_pct: lower on low-RAM systems to save power, higher on high-RAM #}
{% if ram_mb <= 4096 %}
{% set min_perf_pct = 30 %}
{% elif ram_mb <= 8192 %}
{% set min_perf_pct = 35 %}
{% else %}
{% set min_perf_pct = 40 %}
{% endif %}

{# nr_rqs: scale with CPU cores #}
{% if vcpus <= 4 %}
{% set nr_rqs = 512 %}
{% elif vcpus <= 8 %}
{% set nr_rqs = 1024 %}
{% else %}
{% set nr_rqs = 2048 %}
{% endif %}

[main]
include=desktop

[cpu]
governor=balanced_performance
energy_performance_preference=balance_performance
boost=1
max_perf_pct=100
min_perf_pct={{ min_perf_pct }}
force_latency=1

[kernel]
nmi_watchdog=0
sched_autogroup=0

[vm]
transparent_hugepages=madvise
transparent_hugepages_defrag=madvise

[audio]
timeout=0
alsa_buffer_size=32
alsa_period_size=128

[scheduler]
runtime=0
nr_rqs={{ nr_rqs }}

[sysctl]
kernel.timer_migration=0
vm.zone_reclaim_mode=0
vm.dirty_ratio=3
vm.dirty_background_ratio=1
vm.vfs_cache_pressure=100
vm.swappiness=1
vm.compaction_proactiveness=0
vm.page_lock_unfairness=1
kernel.numa_balancing=0
vm.watermark_boost_factor=0
vm.watermark_low_factor=200

[service]
service.stopped=abrtd,abrt-journal-core,cups,geoclue,ModemManager,packagekit
